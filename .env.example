BOT_TOKEN=123456:ABC-your-bot-token
OWNER_ID=123456789
UPDATES_URL=https://t.me/your_updates_channel
# --- Database ---
# MONGO_URI bharoge to MongoDB use hoga, khali chhodoge to SQLite (DB_PATH file)
MONGO_URI=
MONGO_DB=roohiremov
DB_PATH=roohiremov.db
# Logger: channel/group ID jaha logs aayenge (bot ko wahan admin banao). Khali = logger off
LOG_CHAT_ID=
# Banner image (default: catbox image). Override karna ho to URL/file_id
PING_IMG=https://files.catbox.moe/1egfqy.png
START_IMG=
# Premium emoji: emojis.py me IDs bharo, phir true (README dekho)
PREMIUM_EMOJI=false
# Support group/channel link (SUPPORT button)
OWNER_URL=
SUPPORT_URL=https://t.me/your_support_chat

# --- Auto promo: roz is time pe "live" post sab users/groups/channels ko ---
AUTO_PROMO=true
PROMO_AT=07:00
PROMO_TZ=Asia/Kolkata
PROMO_IMG=
